# ============================================
# KDice English Platform - Environment Config
# ============================================

# Server
PORT=3001
NODE_ENV=development

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kdice_english
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRES_IN=7d

# Super Admin (se crea automáticamente al iniciar)
SUPER_ADMIN_EMAIL=admin@kdice.com
SUPER_ADMIN_PASSWORD=Aasdsad

# IA Gratuita - Groq (https://console.groq.com - GRATIS)
# Free tier: 14,400 requests/day, 6,000 tokens/min
GROQ_API_KEY=your_groq_api_key_here

# IA Gratuita - Google Gemini (https://aistudio.google.com - GRATIS)
# Free tier: 15 RPM, 1M tokens/day
GEMINI_API_KEY=your_gemini_api_key_here

# Control de uso de IA por usuario
AI_DAILY_LIMIT=20          # Interacciones IA por usuario por día
AI_TOKENS_PER_REQUEST=150  # Máximo tokens por request (respuesta corta)

# Frontend URL (para CORS)
CLIENT_URL=http://localhost:5173

# Bcrypt rounds
BCRYPT_ROUNDS=10
